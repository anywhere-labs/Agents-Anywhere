<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="device_pairing_connection_title">连接您的设备</string>
    <string name="device_pairing_connection_description">您可以通过桌面程序或 CLI 连接您的设备。</string>
    <string name="device_pairing_desktop_title">使用桌面程序连接</string>
    <string name="device_pairing_desktop_description">如果您使用 Windows 或 macOS，搭配桌面程序连接可以获得最佳体验。</string>
    <string name="device_pairing_cli_title">使用命令行连接</string>
    <string name="device_pairing_cli_description">使用一行命令连接您的设备，建议用于 Linux。</string>
    <string name="device_pairing_desktop_install_title">使用桌面程序连接</string>
    <string name="device_pairing_desktop_install_description">前往官网下载页下载 Agents Anywhere 桌面程序，然后按照下方步骤完成连接。</string>
    <string name="device_pairing_desktop_download_title">下载并安装</string>
    <string name="device_pairing_desktop_install_step_download">在官网下载页选择适合您设备的 Windows 或 macOS 安装包，下载后完成安装。</string>
    <string name="device_pairing_desktop_login_title">打开程序并登录</string>
    <string name="device_pairing_desktop_install_step_login">打开桌面程序，连接到您当前使用的服务，并使用同一个账号登录。</string>
    <string name="device_pairing_desktop_online_title">等待设备上线</string>
    <string name="device_pairing_desktop_install_step_online">登录后，桌面程序会自动连接这台设备。回到当前应用，即可在设备列表中查看并使用它。</string>
    <string name="device_pairing_command_warning_title">确定要使用命令行吗？</string>
    <string name="device_pairing_command_warning_description">此方式需要一定的计算机基础，您需要会使用终端以及 uv / uvx 命令行工具。</string>
    <string name="device_pairing_command_warning_fallback">如果您使用 Windows 或 macOS，更推荐使用桌面程序，连接和日常使用会更方便。</string>
    <string name="device_pairing_command_warning_desktop">使用桌面程序</string>
    <string name="device_pairing_command_warning_confirm">继续使用命令行</string>
    <string name="device_pairing_name_title">命名设备</string>
    <string name="device_pairing_name_description">为您的设备起一个容易辨认的名字，然后选择配对方式。</string>
    <string name="device_pairing_name_label">设备名</string>
    <string name="device_pairing_name_placeholder">例如 amber-finch</string>
    <string name="device_pairing_method_title">选择配对方式</string>
    <string name="device_pairing_method_description">选择一种方式，将 %1$s 连接到您的账号。</string>
    <string name="device_pairing_pair_code_title">使用配对码</string>
    <string name="device_pairing_pair_code_description">在设备终端运行命令，将生成的 6 位配对码填回这里。</string>
    <string name="device_pairing_token_title">使用 Token</string>
    <string name="device_pairing_token_description">在设备终端运行包含 Token 的命令，直接完成连接。</string>
    <string name="device_pairing_command_step_title">使用 Token 连接</string>
    <string name="device_pairing_command_step_description">在 %1$s 的终端中运行下方命令，设备会自动连接到您的账号。</string>
    <string name="device_pairing_linux_session_warning">请保持终端运行，关闭后设备会离线。如果您使用 Linux，可以通过 screen 保持后台会话：</string>
    <string name="device_pairing_linux_detach_hint">设备上线后，在 screen 会话中按 Ctrl-A，再按 D，即可离开并保持后台运行。需要返回会话时运行：</string>
    <string name="device_pairing_waiting_online">等待设备上线...</string>
    <string name="device_pairing_code_step_title">使用配对码配对</string>
    <string name="device_pairing_code_step_description">将 %1$s 的配对码填入下方，即可完成连接。</string>
    <string name="device_pairing_pair_command">在设备上运行</string>
    <string name="device_pairing_pair_command_hint">运行命令后，将终端显示的 6 位配对码输入下方。</string>
    <string name="device_pairing_code_label">设备上的配对码</string>
    <string name="device_pairing_confirming">正在确认配对，等待设备上线...</string>
    <string name="device_pairing_claim">认领</string>
    <string name="device_pairing_exit_title">设备已创建</string>
    <string name="device_pairing_exit_description">设备 %1$s 已经创建但尚未完成配对。如果不再需要，请在设备列表中手动删除。</string>
    <string name="device_pairing_continue_pairing">继续配对</string>
    <string name="device_pairing_close_anyway">仍然关闭</string>
    <string name="device_pairing_copy_command">复制命令</string>
    <string name="device_pairing_errors_create_failed">无法创建连接器。</string>
    <string name="device_pairing_errors_claim_failed">无法认领配对。</string>
    <string name="device_pairing_errors_copy_failed">复制失败，请选中命令后手动复制。</string>
    <string name="device_pairing_download">前往官网下载</string>
    <string name="device_pairing_exit_waiting_description">离开页面后仍会等待 %1$s 上线，并更新设备列表。如果不再需要这台设备，请在设备列表中删除。</string>
    <string name="device_pairing_open_download_failed">无法打开下载页面，请稍后重试。</string>
</resources>
