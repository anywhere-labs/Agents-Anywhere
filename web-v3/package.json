{
  "name": "@anywhere-labs/web-v3",
  "version": "3.0.0-alpha.1",
  "description": "Agents Anywhere v3 Web Workbench & Portable Assistant (Pi Lite) built on Next.js App Router + Anywhere UI",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed:build": "vite build --config embed/vite.config.ts",
    "embed:dev": "vite --config embed/vite.config.ts",
    "embed:schema": "node embed/scripts/gen-schema.mjs",
    "embed:fixtures": "node embed/scripts/build-fixtures.mjs",
    "embed:smoke": "node embed/scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@luzixu/harmonyos-sans": "0.1.2",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.60.0",
    "meshcall": "^0.4.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.65",
    "tailwindcss": "^4",
    "ts-json-schema-generator": "^2.10.0",
    "typescript": "^5",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.10"
  }
