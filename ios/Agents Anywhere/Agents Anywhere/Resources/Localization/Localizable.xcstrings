    "%@ is online. You can now choose which agents to configure and start on this device, or finish without adding any.": {
      "comment": "Shared with Web: dashboard.pairDevice.successDescription. Sync with ios/scripts/web_copy.py.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is online. Choose which agents to configure and start, or finish without adding one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已上线。你可以选择要配置并启动的 Agent，也可以不添加直接完成。"
          }
        }
      }
    },
    "%@ will be stopped and removed from the configured list. You can add it again later; its instance identity, sessions, and timeline history are kept, and the local installation is not deleted.": {
      "comment": "Shared with Web: dashboard.device.deleteRuntimeConfigDescription. Sync with ios/scripts/web_copy.py.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be stopped and removed from the configured list. You can add it again later; its instance identity, sessions, and timeline history are kept, and the local installation is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会停止并从已配置列表移除，之后仍可重新添加。实例身份、已有会话和 Timeline 历史都会保留，本机安装也不会被删除。"
          }
        }
      }
    },
