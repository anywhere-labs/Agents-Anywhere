{
  "name": "@agents-anywhere/dsh-bridge-next",
  "version": "0.1.0-dev.0",
  "description": "Agents Anywhere login, local Connector management and Web onboarding for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "yarn clean && tsdown && node scripts/bundle-connector.ts",
    "dev": "node scripts/bundle-connector.ts && tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.scripts.json",
    "check:build": "node scripts/check-build.ts",
    "check": "yarn typecheck && yarn build && yarn check:build && yarn test",
    "prepack": "yarn check",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "yarn@4.18.0",
  "license": "MIT",
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.41.0"
  }
}
