{
  "name": "@agents-anywhere/dsh-bridge-next",
  "version": "0.1.0-dev.0",
  "description": "Agents Anywhere plugin scaffold for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "yarn clean && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.scripts.json",
    "check:build": "node scripts/check-build.ts",
    "check": "yarn typecheck && yarn build && yarn check:build",
    "prepack": "yarn check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.31",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "yarn@4.18.0",
  "license": "MIT"
}
