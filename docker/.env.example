# Agents Anywhere 生产环境变量
#
# 复制到 docker/.env（compose 只读取 compose 文件同目录的 .env）：
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
#
# 这些值会注入容器，不要把 docker/.env 提交进仓库（已加入 .gitignore）。

# ── 必填 ──────────────────────────────────────────────────────────────
# 数据库密码，建议 openssl rand -hex 24
POSTGRES_PASSWORD=
# 签发登录 token 的密钥，建议 openssl rand -hex 32；一旦更换所有登录态失效
AGENT_SERVER_SECRET=
# 公网访问地址，用于 OAuth 回调和分享链接；不带结尾斜杠
AGENT_SERVER_PUBLIC_ORIGIN=https://agents.example.com

# ── 单端口发布 ────────────────────────────────────────────────────────
# 只填端口数字，不要写 IP:PORT
AGENTS_ANYWHERE_WEB_PORT=5174
# 默认只监听回环，由机器上的 TLS 入口（云 LB / 已有 nginx / cloudflared）转发进来。
# 要直接对外暴露这一个端口，改成 0.0.0.0。
AGENTS_ANYWHERE_BIND_IP=127.0.0.1

# ── 可选 ──────────────────────────────────────────────────────────────
# 只有把 API 拆到独立域名时才需要；同源单端口留空即可
AGENT_SERVER_CORS_ORIGINS=
# 首次注册的管理员 setup token 有效期（秒），留空用服务端默认值
AGENT_SERVER_SETUP_TOKEN_TTL=
# Redis 内存上限；Timeline 未落盘写入不可驱逐，按实例规模调整
REDIS_MAXMEMORY=512mb
# PostgreSQL 连接池
AGENT_SERVER_DB_POOL_SIZE=10
AGENT_SERVER_DB_MAX_OVERFLOW=20
AGENT_SERVER_DB_POOL_TIMEOUT=30
AGENT_SERVER_DB_POOL_RECYCLE=1800
AGENT_SERVER_MIGRATION_LOCK_TIMEOUT=120
# Timeline 序列号租约大小；越大越省数据库写入，但 Redis 丢失后留下的空洞越大
AGENT_SERVER_TIMELINE_REVISION_LEASE_SIZE=4096
# 已经用镜像仓库分发镜像时覆盖，默认用本地构建的 tag
AGENTS_ANYWHERE_SERVER_IMAGE=agents-anywhere-server:postgres

# ── 对象存储（可选，默认 local 落 /data 卷）───────────────────────────
# AGENT_SERVER_FILES_BACKEND=s3
# AGENT_SERVER_FILES_S3_BUCKET=
# AGENT_SERVER_FILES_S3_PREFIX=
# AGENT_SERVER_FILES_S3_ACCESS_KEY=
# AGENT_SERVER_FILES_S3_SECRET_KEY=
# AGENT_SERVER_FILES_S3_REGION=us-east-1
# AGENT_SERVER_FILES_S3_ENDPOINT_URL=
# AGENT_SERVER_FILES_S3_VIRTUAL_HOST_STYLE=
