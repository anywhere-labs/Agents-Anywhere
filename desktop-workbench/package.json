{
  "name": "agents-anywhere-desktop-workbench",
  "productName": "Agents Anywhere",
  "private": true,
  "version": "2.1.0",
  "description": "Electron shell for the Agents Anywhere web workbench",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "renderer"
  ],
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:info": "node scripts/write-build-info.mjs",
    "build:main": "yarn build:info && tsc -p tsconfig.json",
    "renderer:typecheck": "yarn workspace agents-anywhere-desktop-renderer typecheck",
    "typecheck": "yarn build:info && tsc -p tsconfig.json --noEmit",
    "test:main": "yarn build:main && node --test dist/electron/*.test.js dist/electron/backend/*.test.js",
    "dev": "yarn build:main && node scripts/dev.mjs",
    "start": "yarn ensure:uv && yarn build:main && electron .",
    "build:web": "node scripts/build-web.mjs",
    "build": "yarn build:main && yarn build:web",
    "ensure:uv": "node scripts/ensure-uv.mjs",
    "bundle:uv": "node scripts/prepare-uv.mjs",
    "bundle:python": "node scripts/prepare-python.mjs",
    "pack": "yarn bundle:uv && yarn bundle:python && yarn build && electron-builder --dir",
    "dist": "node scripts/dist-desktop.mjs",
    "dist:mac": "node scripts/dist-desktop.mjs mac",
    "dist:win": "node scripts/dist-desktop.mjs win"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "proxy-agent": "^8.0.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "dev.agentsanywhere.workbench",
    "productName": "Agents Anywhere",
    "files": [
      "dist/electron/**",
      "dist/shared/**",
      "dist/config.json",
      "dist/build-info.json",
      "!dist/electron/development-login.js",
      "!dist/electron/*.test.js",
      "!dist/electron/backend/*.test.js",
      "!node_modules/agents-anywhere-desktop-renderer/**",
      "renderer/out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../connector",
        "to": "connector",
        "filter": [
          "pyproject.toml",
          "README.md",
          "connector/**",
          "!**/__pycache__/**",
          "!**/_reference/**",
          "!**/_deprecated/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../logo",
        "to": "logo",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "build/icon-mac-source.png",
        "to": "build/icon-mac-source.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/uv",
        "to": "uv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Agents Anywhere Desktop OAuth",
        "schemes": [
          "agents-anywhere-desktop"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "{Contents/Resources/uv/darwin-*/uv,Contents/Resources/python/darwin-*/**,Contents/Resources/app.asar.unpacked/node_modules/{@img/sharp-darwin-*,@img/sharp-libvips-darwin-*,@next/swc-darwin-*,@swc/core-darwin-*,@parcel/watcher-darwin-*,@tailwindcss/oxide-darwin-*,lightningcss-darwin-*}/**}",
      "signIgnore": [
        "\\.(?:pak|dat|wasm|pyc|pickle|whl)$"
      ]
    },
    "linux": {
      "icon": "build/icon-mac-source.png",
      "target": "AppImage"
    }
  }
}
