{
  "name": "agents-anywhere-desktop-workbench",
  "productName": "Agents Anywhere",
  "private": true,
  "version": "2.2.0",
  "description": "Electron shell for the Agents Anywhere web workbench",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "renderer"
  ],
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:info": "node scripts/write-build-info.mjs",
    "build:main": "yarn build:info && tsc -p tsconfig.json",
    "renderer:typecheck": "yarn workspace agents-anywhere-desktop-renderer typecheck",
    "typecheck": "yarn build:info && tsc -p tsconfig.json --noEmit",
    "test:main": "yarn build:main && node --test dist/electron/*.test.js dist/electron/backend/*.test.js",
    "dev": "yarn build:main && node scripts/dev.mjs",
    "start": "yarn bundle:router && yarn bundle:frpc && yarn bundle:connector && yarn build:main && electron .",
    "build:web": "node scripts/build-web.mjs",
    "build": "yarn bundle:connector && yarn build:main && yarn build:web",
    "bundle:connector": "node scripts/bundle-connector.mjs",
    "bundle:router": "node scripts/prepare-router.mjs",
    "bundle:frpc": "node scripts/prepare-frpc.mjs",
    "bundle:pi": "node scripts/prepare-pi-runtime.mjs",
    "pack": "yarn bundle:router && yarn bundle:frpc && yarn bundle:pi && yarn build && electron-builder --dir",
    "dist": "node scripts/dist-desktop.mjs",
    "dist:mac": "node scripts/dist-desktop.mjs mac",
    "dist:win": "node scripts/dist-desktop.mjs win"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/ws": "8.18.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "proxy-agent": "^8.0.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "dev.agentsanywhere.workbench",
    "afterPack": "scripts/after-pack.cjs",
    "productName": "Agents Anywhere",
    "files": [
      "dist/electron/**",
      "dist/shared/**",
      "dist/connector/**",
      "!dist/connector/*.map",
      "dist/config.json",
      "dist/build-info.json",
      "!dist/electron/development-login.js",
      "!dist/electron/*.test.js",
      "!dist/electron/backend/*.test.js",
      "!node_modules/agents-anywhere-desktop-renderer/**",
      "!node_modules/meshcall-router-*/**",
      "renderer/out/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist/connector/**"
    ],
    "extraResources": [
      {
        "from": "../logo",
        "to": "logo",
        "filter": [
          "*.png"
        ]
      },
      {
        "from": "build/icon-mac-source.png",
        "to": "build/icon-mac-source.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/meshcall-router",
        "to": "meshcall-router",
        "filter": [
          "**/meshcall-router",
          "**/meshcall-router.exe"
        ]
      },
      {
        "from": "build/frpc",
        "to": "frpc",
        "filter": [
          "**/frpc",
          "**/frpc.exe",
          "**/LICENSE"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Agents Anywhere Desktop OAuth",
        "schemes": [
          "agents-anywhere-desktop"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "{Contents/Resources/meshcall-router/darwin-*/meshcall-router,Contents/Resources/frpc/darwin-*/frpc,Contents/Resources/app.asar.unpacked/node_modules/{@img/sharp-darwin-*,@img/sharp-libvips-darwin-*,@next/swc-darwin-*,@swc/core-darwin-*,@parcel/watcher-darwin-*,@tailwindcss/oxide-darwin-*,lightningcss-darwin-*}/**}",
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$"
      ]
    },
    "linux": {
      "icon": "build/icon-mac-source.png",
      "target": "AppImage"
    }
  },
  "dependencies": {
    "meshcall": "file:../vendor/meshcall/meshcall-0.4.0-dev.9334405.tgz"
  }
}
