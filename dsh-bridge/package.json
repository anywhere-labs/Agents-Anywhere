{
  "name": "@agents-anywhere/dsh-bridge",
  "version": "0.1.0",
  "description": "Agents Anywhere bridge and Desktop status UI for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-cmdline": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.6 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.10.0",
  "license": "MIT"
}
