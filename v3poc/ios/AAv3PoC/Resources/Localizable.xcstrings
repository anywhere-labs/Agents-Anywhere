    "connection.no_devices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到设备。"
          }
        }
      }
    },
    "connection.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "connection.invalid_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid HTTPS server address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 HTTPS 服务器地址。"
          }
        }
      }
    },
    "connection.key_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device key has changed. Verify it on your computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备密钥已变更，请在电脑上核对。"
          }
        }
      }
    },
    "connection.forget_pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget local pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记本机配对"
          }
        }
      }
    },
    "connection.forget_pairing_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair again with a new link from your Connector."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用电脑端生成的新链接重新配对。"
          }
        }
      }
    },
    "connection.agent_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent unavailable. Check it on your computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 无法启动，请在电脑上检查。"
          }
        }
      }
    },
    "connection.delivery_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message delivery failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息发送失败。"
          }
        }
      }
    },
    "connection.ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Agents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问 Agents"
          }
        }
      }
    },
    "connection.device_offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device offline. Sending is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备离线，暂时不能发送。"
          }
        }
      }
    },
    "connection.wrong_device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing link does not match this device or server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接与当前设备或服务器不匹配。"
          }
        }
      }
    },
    "connection.unauthorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected your credentials. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了凭据，请重新登录。"
          }
        }
      }
    },
    "connection.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to the server. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器，请重试。"
          }
        }
      }
    },
    "connection.pair_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the encrypted workspace. Check the device and pairing link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开加密工作区，请检查设备和配对链接。"
          }
        }
      }
    },
    "connection.encrypted_session": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密会话"
          }
        }
      }
    },
