    "connection.send_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery was not confirmed. Retry the message to check its outcome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备尚未确认收到消息。可重试当前消息以确认结果。"
