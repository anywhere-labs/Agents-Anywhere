      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话"
          }
        }
      }
    },
