      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No available runtimes on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有可用的 Agent。"
