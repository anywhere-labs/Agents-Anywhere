    "connection.create_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm the new session. Retry with the same details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认会话是否已创建。请保留原内容重试。"
          }
        }
      }
    },
    "connection.runtime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        }
      }
    },
    "connection.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
