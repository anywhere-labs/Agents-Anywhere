      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can attach up to five files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可添加五个附件。"
          }
        }
      }
