    "connection.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open workspace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开工作区"
          }
        }
