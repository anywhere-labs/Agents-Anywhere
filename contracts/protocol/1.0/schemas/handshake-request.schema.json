{
  "$defs": {
    "ProtocolRuntimeIdentity": {
      "properties": {
        "runtime": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Runtime",
          "type": "string"
        },
        "runtimeVersion": {
          "title": "Runtimeversion",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "runtimeVersion"
      ],
      "title": "ProtocolRuntimeIdentity",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:protocol:1.0:handshake-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "connectorVersion": {
      "title": "Connectorversion",
      "type": "string"
    },
    "protocolVersions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Protocolversions",
      "type": "array"
    },
    "runtimes": {
      "items": {
        "$ref": "#/$defs/ProtocolRuntimeIdentity"
      },
      "title": "Runtimes",
      "type": "array"
    }
  },
  "required": [
    "protocolVersions",
    "connectorVersion"
  ],
  "title": "ProtocolHandshakeRequest",
  "type": "object",
  "x-direction": "ingress",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
