{
  "$id": "urn:agents-anywhere:protocol:1.0:planning-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 100,
      "title": "Attachments",
      "type": "array"
    },
    "command": {
      "enum": [
        "enter_plan",
        "exit_plan",
        "submit_task",
        "approve_and_execute",
        "request_revision",
        "dismiss_review"
      ],
      "title": "Command",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "maxLength": 2097152,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "contentHash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contenthash"
    },
    "epoch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Epoch"
    },
    "expectedRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectedrevision"
    },
    "feedback": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback"
    },
    "operationId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operationid",
      "type": "string"
    },
    "planId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planid"
    },
    "planRevision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planrevision"
    },
    "reviewId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewid"
    }
  },
  "required": [
    "command",
    "operationId"
  ],
  "title": "PlanningRequest",
  "type": "object",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
