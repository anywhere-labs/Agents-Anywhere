          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "sessionId",
        "clientMessageId",
        "content",
        "attachments",
        "status",
        "position",
        "interruptRequested",
        "createdBy",
        "createdAt",
        "updatedAt",
        "error"
      ],
      "title": "SessionQueueItem",
      "type": "object"
    }
