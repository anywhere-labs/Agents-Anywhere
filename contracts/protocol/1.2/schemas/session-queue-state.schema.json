  "$id": "urn:agents-anywhere:protocol:1.2:session-queue-state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``GET /sessions/{id}/runtime/queue``: the device's queue; empty with ``deviceOffline`` when it is offline.",
  "properties": {
    "deviceOffline": {
      "default": false,
      "title": "Deviceoffline",
      "type": "boolean"
    },
    "items": {
