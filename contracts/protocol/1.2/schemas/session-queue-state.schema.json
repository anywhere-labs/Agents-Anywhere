        },
        "clientMessageId": {
          "title": "Clientmessageid",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "createdBy": {
          "title": "Createdby",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionQueueError"
