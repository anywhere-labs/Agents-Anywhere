      "type": "integer"
    },
    "sessionId": {
      "title": "Sessionid",
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "revision",
    "items",
    "deviceOffline"
  ],
  "title": "SessionQueueStateV12",
  "type": "object",
  "x-contract": "protocol",
  "x-direction": "egress",
  "x-protocol-version": "1.2",
  "x-pydantic-mode": "serialization"
}
