{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunkBytes",
    "receivedChunks",
    "committed"
  ],
  "properties": {
    "chunkBytes": {
      "const": 262144
    },
    "receivedChunks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1023
      }
    },
    "committed": {
      "type": "boolean"
    }
  }
}
