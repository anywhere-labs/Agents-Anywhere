{
  "$defs": {
    "ProtocolModelCatalog": {
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/ProtocolModelItem"
          },
          "title": "Models",
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "revision"
      ],
      "title": "ProtocolModelCatalog",
      "type": "object"
    },
    "ProtocolModelGroup": {
      "description": "Where a model is routed from, e.g. a DSH provider or relay.",
      "properties": {
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "itemDisplayName": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itemdisplayname"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "title": "ProtocolModelGroup",
      "type": "object"
    },
    "ProtocolModelItem": {
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolModelGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "reasoningItems": {
          "items": {
            "$ref": "#/$defs/ProtocolReasoningItem"
          },
          "title": "Reasoningitems",
          "type": "array"
        },
        "selectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectionid"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "title": "ProtocolModelItem",
      "type": "object"
    },
    "ProtocolPermissionCatalog": {
      "properties": {
        "permissions": {
          "items": {
            "$ref": "#/$defs/ProtocolPermissionItem"
          },
          "title": "Permissions",
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "revision"
      ],
      "title": "ProtocolPermissionCatalog",
      "type": "object"
    },
    "ProtocolPermissionItem": {
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "selectionId": {
          "title": "Selectionid",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "id",
        "selectionId"
      ],
      "title": "ProtocolPermissionItem",
      "type": "object"
    },
    "ProtocolReasoningItem": {
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "fullModelId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fullmodelid"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "selectionId": {
          "title": "Selectionid",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "id",
        "selectionId"
      ],
      "title": "ProtocolReasoningItem",
      "type": "object"
    },
    "SessionCatalogs": {
      "description": "A session's catalogs: models, permissions, slash commands and the current selections.",
      "properties": {
        "commands": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SlashCommand"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commands"
        },
        "models": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolModelCatalog"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolPermissionCatalog"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selections": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selections"
        }
      },
      "title": "SessionCatalogs",
      "type": "object"
    },
    "SlashCommand": {
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "inputHint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputhint"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SlashCommand",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:device-meshcall:1.0:runtime-catalogs-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``Runtime/catalogs``: ``catalogs`` is empty while the session is not open on the device.",
  "properties": {
    "catalogs": {
      "$ref": "#/$defs/SessionCatalogs"
    },
    "sessionId": {
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    }
  },
  "required": [
    "sessionId"
  ],
  "title": "RuntimeCatalogsResponse",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
