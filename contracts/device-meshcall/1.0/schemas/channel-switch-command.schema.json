{
  "$defs": {
    "ModelGateway": {
      "description": "The model gateway a Runtime instance uses, as the device takes it (the Server keeps it in the config).",
      "properties": {
        "authToken": {
          "minLength": 1,
          "title": "Authtoken",
          "type": "string"
        },
        "baseUrl": {
          "minLength": 1,
          "title": "Baseurl",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "protocol": {
          "minLength": 1,
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "baseUrl",
        "authToken",
        "protocol"
      ],
      "title": "ModelGateway",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:device-meshcall:1.0:channel-switch-command",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``channel.switch``: ``runtime.apply`` fenced by the switch the Server is executing\n(``operationId``, ``switchRevision``; sent when the device declared ``channelReconcileFence``).",
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "config": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config"
    },
    "modelGateway": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelGateway"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "operationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operationid"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "runtimeId": {
      "minLength": 1,
      "title": "Runtimeid",
      "type": "string"
    },
    "runtimeType": {
      "minLength": 1,
      "title": "Runtimetype",
      "type": "string"
    },
    "switchRevision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Switchrevision"
    }
  },
  "required": [
    "runtimeId",
    "runtimeType",
    "active"
  ],
  "title": "ChannelSwitchCommand",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
