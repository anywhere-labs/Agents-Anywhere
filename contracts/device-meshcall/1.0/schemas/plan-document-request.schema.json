{
  "$id": "urn:agents-anywhere:device-meshcall:1.0:plan-document-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Without ``planId``: every revision (``{plans}``); with ``planId`` and ``revision``: that one (``{document}``).",
  "properties": {
    "planId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planid"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "sessionId": {
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    }
  },
  "required": [
    "sessionId"
  ],
  "title": "PlanDocumentRequest",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
