    "sessionId": {
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    }
  },
  "required": [
    "sessionId"
  ],
  "title": "SessionCapabilitiesResponse",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
