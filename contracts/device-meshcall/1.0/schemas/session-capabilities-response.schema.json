          "type": "boolean"
        },
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "capabilityId": {
          "title": "Capabilityid",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "runtime": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "scope": {
          "default": "runtime",
          "enum": [
            "runtime",
            "session"
          ],
          "title": "Scope",
          "type": "string"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        },
        "supported": {
          "default": true,
          "title": "Supported",
          "type": "boolean"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailablereason"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "capabilityId"
      ],
      "title": "ProtocolCapability",
      "type": "object"
    },
    "ProtocolCapabilitySet": {
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ProtocolCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision"
