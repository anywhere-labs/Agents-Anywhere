{
  "$defs": {
    "AttachmentRef": {
      "description": "An attachment the Server holds (staged upload): the device fetches it by ``fileId``.",
      "properties": {
        "encrypted": {
          "default": false,
          "title": "Encrypted",
          "type": "boolean"
        },
        "fileId": {
          "minLength": 1,
          "title": "Fileid",
          "type": "string"
        },
        "mediaType": {
          "title": "Mediatype",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "fileId",
        "name",
        "mediaType",
        "size"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "ClientCaller": {
      "description": "Who sent the request, as the Server authenticated it.",
      "properties": {
        "clientId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clientid"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "userId": {
          "minLength": 1,
          "title": "Userid",
          "type": "string"
        }
      },
      "required": [
        "userId"
      ],
      "title": "ClientCaller",
      "type": "object"
    },
    "ClientCommand": {
      "description": "A command route's receipt identity: the device's inbox replays by ``commandId``.",
      "properties": {
        "commandId": {
          "minLength": 1,
          "title": "Commandid",
          "type": "string"
        },
        "deadline": {
          "title": "Deadline",
          "type": "string"
        },
        "inputDigest": {
          "minLength": 1,
          "title": "Inputdigest",
          "type": "string"
        }
      },
      "required": [
        "commandId",
        "inputDigest",
        "deadline"
      ],
      "title": "ClientCommand",
      "type": "object"
    },
    "ClientPreview": {
      "description": "The file a preview token opened, as the Server verified it.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "root": {
          "minLength": 1,
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path"
      ],
      "title": "ClientPreview",
      "type": "object"
    },
    "ClientServerFacts": {
      "description": "Facts the Server owns. The device takes them over whatever the body says, on ``Client/call`` only.",
      "properties": {
        "archived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "whether the session is archived in the directory",
          "title": "Archived"
        },
        "attachments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AttachmentRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the Server's records of the attachments the body references",
          "title": "Attachments"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientPreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a preview read: the file its token opened"
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "create-and-start: the directory row the Server created",
          "title": "Sessionid"
        },
        "takeover": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Takeover"
        },
        "transfer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientTransfer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "fs/read: where the device PUTs the bytes"
        }
      },
      "title": "ClientServerFacts",
      "type": "object"
    },
    "ClientTransfer": {
      "description": "The relay a ``fs/read`` download goes through: where the device ``PUT``s the bytes, and where the client\nfetches them.",
      "properties": {
        "downloadUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the URL the client downloads from (a preview download carries its previewAccessToken); default the device's own fs/transfers route",
          "title": "Downloadurl"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        },
        "transferId": {
          "minLength": 1,
          "title": "Transferid",
          "type": "string"
        }
      },
      "required": [
        "transferId",
        "token",
        "path"
      ],
      "title": "ClientTransfer",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:device-meshcall:1.0:client-call-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``Client/call``: one client API request. ``path`` is what the client called (``/api/v2/...``) with the\nquery left out; ``route`` names its table entry so the device checks it and picks the lane first.",
  "properties": {
    "body": {
      "default": null,
      "title": "Body"
    },
    "byteBudget": {
      "anyOf": [
        {
          "minimum": 4096,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bytebudget"
    },
    "caller": {
      "$ref": "#/$defs/ClientCaller"
    },
    "command": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientCommand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "title": "Method",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "query": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Query",
      "type": "object"
    },
    "route": {
      "enum": [
        "session.createAndStart",
        "session.snapshot",
        "session.timeline",
        "session.events",
        "session.runtime.state",
        "session.runtime.capabilities",
        "session.runtime.notices",
        "session.runtime.queue",
        "session.runtime.commands",
        "session.runtime.catalogs.model",
        "session.runtime.catalogs.permission",
        "session.planning.get",
        "session.goal.get",
        "session.plans.list",
        "session.plans.get",
        "session.plans.markdown",
        "session.runtime.messages",
        "session.runtime.steer",
        "session.runtime.interrupt",
        "session.runtime.notices.respond",
        "session.runtime.selections",
        "session.runtime.commands.execute",
        "session.sync",
        "session.planning.execute",
        "session.goal.execute",
        "session.runtime.queue.clear",
        "session.runtime.queue.reorder",
        "session.runtime.queue.resume",
        "session.runtime.queue.update",
        "session.runtime.queue.delete",
        "session.runtime.queue.retry",
        "session.runtime.queue.sendNow",
        "session.terminals.create",
        "session.terminals.list",
        "session.terminals.close",
        "session.terminals.rename",
        "session.terminals.resize",
        "connector.fs.list",
        "connector.fs.readText",
        "connector.fs.write",
        "connector.fs.read",
        "connector.terminals.create",
        "connector.terminals.list",
        "connector.terminals.close",
        "connector.terminals.rename",
        "connector.terminals.persistence",
        "connector.terminals.resize",
        "connector.terminals.write",
        "connector.terminals.snapshot",
        "connector.terminalsV1.create",
        "connector.terminalsV1.list",
        "connector.terminalsV1.close",
        "connector.terminalsV1.rename",
        "connector.terminalsV1.resize",
        "connector.shell.exec",
        "connector.runtime.catalogs.model",
        "connector.runtime.catalogs.permission",
        "connector.runtime.commands"
      ],
      "title": "Route",
      "type": "string"
    },
    "server": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientServerFacts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "route",
    "method",
    "path",
    "caller"
  ],
  "title": "ClientCallRequest",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
