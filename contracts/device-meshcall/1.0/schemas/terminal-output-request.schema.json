{
  "$id": "urn:agents-anywhere:device-meshcall:1.0:terminal-output-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``Workspace/terminalOutput``: opening subscribes to a terminal's output, cancelling unsubscribes.\n\n``sessionId`` is the scope the terminal was created in (``terminal.create``'s ``sessionId``).",
  "properties": {
    "fromSeq": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Fromseq",
      "type": "integer"
    },
    "sessionId": {
      "minLength": 1,
      "title": "Sessionid",
      "type": "string"
    },
    "terminalId": {
      "minLength": 1,
      "title": "Terminalid",
      "type": "string"
    }
  },
  "required": [
    "terminalId",
    "sessionId"
  ],
  "title": "TerminalOutputRequest",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
