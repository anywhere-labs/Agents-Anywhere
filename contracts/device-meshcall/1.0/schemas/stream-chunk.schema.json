        }
      ],
      "title": "Chunk"
    },
    "end": {
      "default": false,
      "title": "End",
      "type": "boolean"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    }
  },
  "required": [
    "seq",
    "chunk"
  ],
  "title": "StreamChunk",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
