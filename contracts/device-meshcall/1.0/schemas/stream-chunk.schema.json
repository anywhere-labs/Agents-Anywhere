{
  "$id": "urn:agents-anywhere:device-meshcall:1.0:stream-chunk",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One item of a large read (``Sessions/snapshot``, ``Store/readBlob``...).",
  "properties": {
    "chunk": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
