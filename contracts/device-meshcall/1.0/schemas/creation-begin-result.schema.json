{
  "$defs": {
    "DirectCreationResult": {
      "properties": {
        "clientMessageId": {
          "minLength": 1,
          "title": "Clientmessageid",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "accepted",
            "queued",
            "duplicate"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "item": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item"
        },
        "queue": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionQueueState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "queuePosition": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queueposition"
        },
        "sessionId": {
          "minLength": 1,
          "title": "Sessionid",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        }
      },
      "required": [
        "delivery",
        "clientMessageId",
        "sessionId"
      ],
      "title": "DirectCreationResult",
      "type": "object"
    },
    "ProtocolModelCatalog": {
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/ProtocolModelItem"
          },
          "title": "Models",
          "type": "array"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "revision"
      ],
      "title": "ProtocolModelCatalog",
      "type": "object"
    },
    "ProtocolModelGroup": {
      "description": "Where a model is routed from, e.g. a DSH provider or relay.",
      "properties": {
        "displayName": {
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "itemDisplayName": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itemdisplayname"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "title": "ProtocolModelGroup",
      "type": "object"
    },
    "ProtocolModelItem": {
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolModelGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "reasoningItems": {
          "items": {
            "$ref": "#/$defs/ProtocolReasoningItem"
          },
          "title": "Reasoningitems",
          "type": "array"
        },
        "selectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selectionid"
        }
      },
      "required": [
        "displayName",
        "id"
      ],
      "title": "ProtocolModelItem",
      "type": "object"
    },
    "ProtocolReasoningItem": {
      "properties": {
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "fullModelId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fullmodelid"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "selectionId": {
          "title": "Selectionid",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "id",
        "selectionId"
      ],
      "title": "ProtocolReasoningItem",
      "type": "object"
    },
    "SessionQueueAttachment": {
      "properties": {
        "fileId": {
          "title": "Fileid",
          "type": "string"
        },
        "mediaType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediatype"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "fileId"
      ],
      "title": "SessionQueueAttachment",
      "type": "object"
    },
    "SessionQueueError": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "SessionQueueError",
      "type": "object"
    },
    "SessionQueueItem": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/SessionQueueAttachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "clientMessageId": {
          "title": "Clientmessageid",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "createdBy": {
          "title": "Createdby",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionQueueError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interruptRequested": {
          "default": false,
          "title": "Interruptrequested",
          "type": "boolean"
        },
        "messageId": {
          "title": "Messageid",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "sending",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "sessionId",
        "clientMessageId",
        "content",
        "status",
        "position",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "title": "SessionQueueItem",
      "type": "object"
    },
    "SessionQueueState": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/SessionQueueItem"
          },
          "title": "Items",
          "type": "array"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "revision"
      ],
      "title": "SessionQueueState",
      "type": "object"
    },
    "WorkflowState": {
      "additionalProperties": true,
      "description": "Keep runtime extensions while validating the shared model catalog.",
      "properties": {
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolModelCatalog"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "WorkflowState",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:device-meshcall:1.0:creation-begin-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DirectCreationResult"
    },
    {
      "$ref": "#/$defs/WorkflowState"
    }
  ],
  "description": "Direct: the first message's delivery; prepared: the creation's workflow state.",
  "title": "CreationBeginResult",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
