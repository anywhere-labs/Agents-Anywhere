{
  "$defs": {
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endedat"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "iterations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iterations"
        },
        "lastReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastreason"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "sourceTurnId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceturnid"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "blocked",
            "usageLimited",
            "budgetLimited",
            "complete",
            "failed",
            "cleared",
            "replaced"
          ],
          "title": "Status",
          "type": "string"
        },
        "timeUsedSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeusedseconds"
        },
        "tokenBudget": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenbudget"
        },
        "tokensUsed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokensused"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "id",
        "objective",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "title": "Goal",
      "type": "object"
    },
    "GoalCapabilities": {
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "set",
              "edit",
              "pause",
              "resume",
              "clear"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "supported": {
          "default": false,
          "title": "Supported",
          "type": "boolean"
        }
      },
      "title": "GoalCapabilities",
      "type": "object"
    },
    "GoalState": {
      "additionalProperties": false,
      "properties": {
        "bindingGeneration": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Bindinggeneration",
          "type": "integer"
        },
        "capabilities": {
          "$ref": "#/$defs/GoalCapabilities"
        },
        "externalSessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Externalsessionid"
        },
        "freshness": {
          "default": "unknown",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Goal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lastOutcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Goal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pendingOperationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pendingoperationid"
        },
        "revision": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "runtimeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtimeid"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "sourceEpoch": {
          "default": "",
          "title": "Sourceepoch",
          "type": "string"
        },
        "sourceRevision": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sourcerevision",
          "type": "integer"
        }
      },
      "required": [
        "sessionId",
        "runtime"
      ],
      "title": "GoalState",
      "type": "object"
    },
    "PlanDocument": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Contenthash",
          "type": "string"
        },
        "contentState": {
          "const": "ready",
          "default": "ready",
          "title": "Contentstate",
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdat"
        },
        "markdown": {
          "maxLength": 2097152,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        },
        "planId": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Planid",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sourceTurnId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceturnid"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "planId",
        "revision",
        "contentHash",
        "title",
        "markdown"
      ],
      "title": "PlanDocument",
      "type": "object"
    },
    "PlanDraft": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "contentState": {
          "enum": [
            "drafting",
            "failed",
            "interrupted"
          ],
          "title": "Contentstate",
          "type": "string"
        },
        "draftId": {
          "title": "Draftid",
          "type": "string"
        },
        "planId": {
          "title": "Planid",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "draftId",
        "planId",
        "revision",
        "seq",
        "content",
        "contentState"
      ],
      "title": "PlanDraft",
      "type": "object"
    },
    "PlanReview": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "enter_plan",
              "exit_plan",
              "submit_task",
              "approve_and_execute",
              "request_revision",
              "dismiss_review"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "contentHash": {
          "title": "Contenthash",
          "type": "string"
        },
        "planId": {
          "title": "Planid",
          "type": "string"
        },
        "planRevision": {
          "minimum": 1,
          "title": "Planrevision",
          "type": "integer"
        },
        "reviewId": {
          "title": "Reviewid",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "responding",
            "approved",
            "revision_requested",
            "dismissed",
            "withdrawn",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reviewId",
        "planId",
        "planRevision",
        "contentHash",
        "status"
      ],
      "title": "PlanReview",
      "type": "object"
    },
    "PlanningCapabilities": {
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "enter_plan",
              "exit_plan",
              "submit_task",
              "approve_and_execute",
              "request_revision",
              "dismiss_review"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "contentStreaming": {
          "default": "final_only",
          "enum": [
            "native_delta",
            "final_only"
          ],
          "title": "Contentstreaming",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "supported": {
          "default": false,
          "title": "Supported",
          "type": "boolean"
        }
      },
      "title": "PlanningCapabilities",
      "type": "object"
    },
    "PlanningState": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/PlanningCapabilities"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effectiveMode": {
          "default": "unknown",
          "enum": [
            "plan",
            "normal",
            "unknown"
          ],
          "title": "Effectivemode",
          "type": "string"
        },
        "epoch": {
          "default": "",
          "title": "Epoch",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution"
        },
        "executionProgress": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executionprogress"
        },
        "freshness": {
          "default": "unknown",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/PlanDocument"
          },
          "title": "Proposals",
          "type": "array"
        },
        "requestedMode": {
          "anyOf": [
            {
              "enum": [
                "plan",
                "normal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestedmode"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "runtimeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtimeid"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "runtime"
      ],
      "title": "PlanningState",
      "type": "object"
    },
    "SessionRuntimeState": {
      "properties": {
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "externalSessionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Externalsessionid"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "runtime": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Runtime",
          "type": "string"
        },
        "selections": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Selections",
          "type": "object"
        },
        "sessionId": {
          "title": "Sessionid",
          "type": "string"
        },
        "status": {
          "default": "idle",
          "enum": [
            "idle",
            "waiting",
            "pending",
            "running",
            "stopping",
            "waiting_approval",
            "error",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "statusReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statusreason"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        },
        "updatedSeq": {
          "title": "Updatedseq",
          "type": "integer"
        }
      },
      "required": [
        "sessionId",
        "runtime",
        "updatedSeq",
        "createdAt",
        "updatedAt"
      ],
      "title": "SessionRuntimeState",
      "type": "object"
    }
  },
  "$id": "urn:agents-anywhere:device-meshcall:1.0:session-state-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "``{state, planning, goal}`` without ``part``; ``{planning}`` or ``{goal}`` with it.",
  "properties": {
    "goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planning": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanningState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionRuntimeState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "SessionStateResponse",
  "type": "object",
  "x-contract": "device-meshcall",
  "x-direction": "bidirectional",
  "x-protocol-version": "1.0",
  "x-pydantic-mode": "validation"
}
