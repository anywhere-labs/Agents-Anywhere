{
  "$id": "https://agents-anywhere.dev/contracts/runtime-control/2.1/schemas/runtime-probe-model-connection-params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parameters for probing the model connection of one running runtime instance. Only sent to Connectors that list modelProbe in features.",
  "properties": {
    "runtime": {
      "description": "Stable provider type; it MUST equal the instance's immutable runtimeType.",
      "maxLength": 64,
      "pattern": "^(?!rti_)[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "runtimeId": {
      "maxLength": 128,
      "pattern": "^(?:(?!rti_)[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*|rti_[A-Za-z0-9_-]+)$",
      "type": "string"
    }
  },
  "required": [
    "runtime",
    "runtimeId"
  ],
  "title": "RuntimeProbeModelConnectionParams",
  "type": "object",
  "x-direction": "ingress",
  "x-rpc-method": "runtime.probeModelConnection",
  "x-rpc-part": "params",
  "x-runtime-control-version": "2.1"
}
