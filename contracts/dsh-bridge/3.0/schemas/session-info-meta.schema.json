{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-info-meta.schema.json",
  "title": "DshSessionInfoMeta",
  "description": "_meta.dsh of a session/list entry or _session/list/changes upsert (§4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "running",
    "lastSeq",
    "writer"
  ],
  "properties": {
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "running": {
      "type": "boolean"
    },
    "lastSeq": {
      "type": "integer",
      "minimum": 0
    },
    "workspaceId": {
      "type": "string"
    },
    "writer": {
      "type": "string",
      "enum": [
        "host",
        "external",
        "none"
      ],
      "description": "Who holds the DSH session write lock (§9)."
    }
  }
}
