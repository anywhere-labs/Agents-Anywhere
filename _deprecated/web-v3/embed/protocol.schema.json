    "UserMessage": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ID"
        },
        "seq": {
          "type": "number"
        },
        "done": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "const": "user"
        },
        "created_at": {
          "$ref": "#/definitions/Instant"
        },
        "author": {
          "type": "string"
        },
        "client_msg_id": {
          "type": "string"
        },
        "steered": {
          "type": "boolean",
          "const": true
        },
        "rewindable": {
          "type": "boolean"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UserPart"
          }
        }
      },
      "required": [
        "id",
        "seq",
        "done",
        "role",
        "created_at",
        "parts"
      ]
    },
    "UserPart": {
      "anyOf": [
