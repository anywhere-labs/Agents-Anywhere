        "mime": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "path",
        "mime",
        "name",
        "size"
      ]
    },
    "FilePart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "file"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "path",
        "name",
        "mime",
        "size"
      ]
    },
    "AssistantMessage": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ID"
        },
        "seq": {
          "type": "number"
        },
        "done": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "const": "assistant"
