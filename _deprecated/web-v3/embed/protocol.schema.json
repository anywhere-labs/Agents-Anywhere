{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agents-anywhere.dev/schemas/aa.render/2/protocol.schema.json",
  "title": "aa.render/2 bridge messages",
  "description": "Every message between the native iOS / Android apps and the WebView render bundle (docs/v3/mobile-bridge.md). Generated from web-v3/embed/src/protocol.ts by `corepack yarn embed:schema`; do not edit by hand.",
  "$ref": "#/definitions/BridgeMessage",
  "definitions": {
    "BridgeMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/NativeMessage"
        },
        {
          "$ref": "#/definitions/WebMessage"
        }
      ],
      "description": "Every message on the bridge, either way (the JSON Schema's root)."
    },
    "NativeMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThemeMessage"
        },
        {
          "$ref": "#/definitions/LocaleMessage"
        },
        {
          "$ref": "#/definitions/ViewConversationMessage"
        },
        {
          "$ref": "#/definitions/ConversationEventMessage"
        },
        {
          "$ref": "#/definitions/ConversationOlderMessage"
        },
        {
          "$ref": "#/definitions/ConversationCachedMessage"
        },
        {
          "$ref": "#/definitions/FileDataMessage"
        },
        {
          "$ref": "#/definitions/ViewTerminalMessage"
        },
        {
          "$ref": "#/definitions/TermSnapshotMessage"
        },
        {
          "$ref": "#/definitions/TermOutputMessage"
        },
        {
          "$ref": "#/definitions/TermControlMessage"
        },
        {
          "$ref": "#/definitions/TermRejectedMessage"
        },
        {
          "$ref": "#/definitions/TermExitMessage"
        },
        {
          "$ref": "#/definitions/TermClosedMessage"
        },
        {
          "$ref": "#/definitions/TermKeyMessage"
        },
        {
          "$ref": "#/definitions/ScrollMessage"
        },
        {
          "$ref": "#/definitions/BatchMessage"
        }
      ]
    },
    "ThemeMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 2,
          "description": "Always 2."
        },
        "type": {
          "type": "string",
          "const": "theme"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "insets": {
          "$ref": "#/definitions/Insets"
        },
        "font_scale": {
          "type": "number",
          "description": "Dynamic Type / font scale; 1 = default (16 px root)."
        },
        "reduce_motion": {
          "type": "boolean"
        },
        "high_contrast": {
          "type": "boolean"
        }
      },
      "required": [
        "insets",
        "scheme",
        "type",
        "v"
      ],
      "description": "Appearance and the safe area covered by native glass controls (CSS px); re-sent whenever it changes."
    },
    "Insets": {
      "type": "object",
      "properties": {
        "top": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "left": {
          "type": "number"
        },
        "right": {
          "type": "number"
        }
      },
      "required": [
        "top",
        "bottom",
        "left",
        "right"
      ]
    },
    "LocaleMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 2,
          "description": "Always 2."
        },
        "type": {
          "type": "string",
          "const": "locale"
        },
        "locale": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ]
        }
      },
      "required": [
        "locale",
        "type",
        "v"
      ]
    },
    "ViewConversationMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 2,
          "description": "Always 2."
        },
        "type": {
          "type": "string",
          "const": "view.conversation"
        },
        "device_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean",
          "description": "No approvals from the thread (e.g. a viewer without answer rights); native still shows its own dock."
        },
        "encrypted": {
          "type": "boolean"
        },
        "me": {
          "type": "string",
          "description": "Extension: the reader's account name (`author` / `answered.by` equal to it read \"你\" and are not labelled)."
        }
      },
      "required": [
        "agent",
        "device_id",
        "encrypted",
        "readonly",
        "session_id",
        "type",
        "v"
      ],
      "description": "Switch to a conversation: the page clears and waits for a `conversation.event` snapshot (or `conversation.cached`)."
    },
    "ConversationEventMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 2,
          "description": "Always 2."
        },
        "type": {
          "type": "string",
          "const": "conversation.event"
        },
        "session_id": {
          "type": "string"
        },
        "event": {
          "$ref": "#/definitions/WatchEvent"
        }
      },
      "required": [
        "event",
        "session_id",
        "type",
        "v"
      ],
      "description": "One `aa.v3.Sessions/watch` WatchEvent, forwarded as is (`snapshot` / `message` / `item` / `session` / `control`)."
    },
    "WatchEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "snapshot"
            },
            "session": {
              "$ref": "#/definitions/Session"
            },
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Message"
              }
            },
            "has_more": {
              "type": "boolean"
            },
            "control": {
              "$ref": "#/definitions/Control"
            }
          },
          "required": [
            "type",
            "session",
            "messages",
            "has_more",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "message"
            },
            "message": {
              "$ref": "#/definitions/Message"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item"
            },
            "message": {
              "$ref": "#/definitions/Message"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "control"
            },
            "control": {
              "$ref": "#/definitions/Control"
            }
          },
          "required": [
            "type",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session"
            },
            "session": {
              "$ref": "#/definitions/Session"
            }
          },
          "required": [
            "type",
            "session"
          ]
        }
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ID"
        },
        "title": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/definitions/AgentKind"
        },
        "device": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/ID"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "cwd": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/definitions/Instant"
        },
        "updated_at": {
          "$ref": "#/definitions/Instant"
        },
        "message_count": {
          "type": "number"
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigOption"
          }
        },
        "forked_from": {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/definitions/ID"
            },
            "message_id": {
              "$ref": "#/definitions/ID"
            }
          },
          "required": [
            "session_id",
            "message_id"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "agent",
        "device",
        "cwd",
        "created_at",
        "updated_at",
        "message_count",
        "config"
      ]
    },
    "ID": {
      "type": "string"
    },
    "AgentKind": {
      "type": "string"
    },
    "Instant": {
      "type": "string"
    },
    "ConfigOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "current": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "group": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "name"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "current",
        "options"
      ]
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/definitions/UserMessage"
